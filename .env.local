# ============================================================================
# API Keys
# ============================================================================
GEMINI_API_KEY_1=   
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
|   |    |
|   |    |
GEMINI_API_KEY_15=  
GEMINI_API_KEY_16=
GEMINI_API_KEY_17=
GEMINI_API_KEY_18=

# ============================================================================
# Simulation clock
#   SIM_REAL_SECONDS_PER_SIM_MINUTE = wall-clock seconds per 1 sim-minute.
#   SIM_TICK_SPEED = speed multiplier (2.0 = 2x faster).
#   Default: 7.5 sec/sim-min => 1440 * 7.5 = 10,800 sec = 3 real hours per sim day.
# ============================================================================
SIM_REAL_SECONDS_PER_SIM_MINUTE=4
SIM_TICK_SPEED=1.0
SIM_MINUTES_PER_TICK=1

# Which simulation day to run (YYYY-MM-DD). Plans/memory are looked up per date.
SIM_START_DATE=2026-07-03
# Time of day to start at (HH:MM). 00:00 = agents asleep at midnight; use e.g.
# 08:00 to begin during the day and see students moving to classes right away.
SIM_START_TIME=00:00

# ============================================================================
# LLM Budget
# ============================================================================
SIM_CREATIVITY=1.1
SIM_WELLBEING_VARIABILITY=1

# Soft ceiling on AI calls per real hour (0 = no limit). Above it, cognition
# degrades gracefully and the sim keeps running on its free path.
SIM_LLM_HOURLY_CEILING=0

# ============================================================================
# Spatial awareness
# ============================================================================
# Pixel radius for perception (who an agent sees).
SIM_PERCEPTION_RADIUS_PX=50
# Agents must be within this many pixels to start a conversation (tighter).
SIM_CONVERSATION_RADIUS_PX=20
SIM_PERCEPTION_ENABLED=true
# Run perception only every N ticks (1 = every tick). Higher = lighter CPU.
SIM_PERCEPTION_EVERY_N_TICKS=3

# ============================================================================
# Memory
# ============================================================================
# Long-term memory backend: "keyword" (offline, default) or "vector" (needs
# qdrant-client installed; falls back to keyword automatically if unavailable).
SIM_MEMORY_BACKEND=vector
SIM_SEMANTIC_MEMORY_ENABLED=true

QDRANT_URL=
QDRANT_API_KEY=

SIM_MEMORY_EMBEDDING_MODEL=gemini-embedding-001
SIM_MEMORY_VECTOR_DIMENSIONS=768
SIM_MEMORY_COLLECTION_VERSION=v1

# ============================================================================
# Budget guards
# ============================================================================
SIM_MAX_CONVERSATIONS_PER_AGENT=5
SIM_MAX_REPLANS_PER_AGENT_PER_DAY=3

# ============================================================================
# Energy/Emotion thresholds for LLM calls
# ============================================================================
SIM_DECIDE_MIN_ENERGY=0.25
SIM_DECIDE_MIN_EMOTION=0.25
SIM_CONVERSATION_MIN_ENERGY=0.25
SIM_CONVERSATION_MIN_EMOTION=0.25

